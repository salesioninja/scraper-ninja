# ==============================================================================
# AGÊNCIA NINJA — CONFIGURAÇÕES DE AMBIENTE (VPS, DOCKER SWARM & TRAEFIK)
# ==============================================================================

# Domínio onde o Scraper será publicado na VPS via Traefik
DOMAIN=scraper.seudominio.com.br

# Nome da rede overlay pública do Traefik no Docker Swarm
TRAEFIK_NETWORK=traefik-public

# Nome do resolver de certificados SSL configurado no seu Traefik (geralmente letsencrypt ou myresolver)
TRAEFIK_CERTRESOLVER=letsencrypt

# Rede interna compartilhada para falar direto com n8n, Evolution API, Typebot, etc.
INTERNAL_NETWORK=ninja-network

# Porta local do Dashboard para testes locais (localhost:8080)
DASHBOARD_PORT=8080

# Versão da imagem do motor de extração Go
SCRAPER_IMAGE=gosom/google-maps-scraper:v1.18.1

# Configurações padrão de integração (também podem ser salvas no painel pelo navegador)
DEFAULT_N8N_WEBHOOK=https://n8n.seudominio.com.br/webhook/ninja-leads
DEFAULT_EVOLUTION_API_URL=http://evolution-api:8080
DEFAULT_EVOLUTION_INSTANCE=ninja-comercial
DEFAULT_EVOLUTION_KEY=sua_chave_evolution_aqui
